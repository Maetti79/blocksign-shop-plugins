name = "BlockSign eSign"
client_id = "YOUR_SHOPIFY_CLIENT_ID"
application_url = "https://your-app.example.com"
embedded = false

[access_scopes]
scopes = "read_customers,read_products,read_orders,write_orders,write_draft_orders,write_app_proxy"

[webhooks]
api_version = "2026-07"

[[webhooks.subscriptions]]
topics = [ "orders/create", "orders/paid", "orders/updated", "orders/cancelled", "refunds/create" ]
uri = "/webhooks"

[app_proxy]
url = "https://your-app.example.com/proxy"
subpath = "blocksign"
prefix = "apps"
